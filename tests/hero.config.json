{
  "$comment": "Harness-agnostic config for tests/hero-headline.py. Point baseUrl at any app that renders the hero (TanStack Start dev server, or a Next.js harness on :3000) \u2014 no code changes needed.",
  "profiles": {
    "tanstack": {
      "baseUrl": "http://localhost:8080",
      "path": "/"
    },
    "nextjs": {
      "baseUrl": "http://localhost:3000",
      "path": "/"
    }
  },
  "defaultProfile": "nextjs",
  "selectors": {
    "hero": "section#top",
    "headline": "h1",
    "headlineLine": "span",
    "label": "section#top p",
    "cta": "section#top a[href=\"#contact\"]"
  },
  "expectedLines": [
    "WE BUILD BRANDS",
    "THAT BEHAVE",
    "LIKE BUSINESSES"
  ],
  "paddingTolerance": 6,
  "pixelThreshold": 12,
  "maxDiffRatio": 0.005,
  "retries": 2,
  "retryDelayMs": 750,
  "viewports": [
    {
      "name": "mobile-320",
      "width": 320,
      "height": 720
    },
